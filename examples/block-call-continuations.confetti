# A regular function call with a block can be the left operand of arithmetic.
sin {pi / 2.0} - 1.0
assert {id {last-val} == 0.0}
assert {id {sin {pi / 2.0} - 1.0} == 0.0}

# A repeated operator still forms one expression without precedence rules.
assert {id {sin {pi / 2.0} + 1.0 + 2.0} == 4.0}

# A complete prefix call is not consumed as an infix continuation.
do {id 5}
+ 1 2 3
assert {id {last-val} == 6}

# The right operand of an infix continuation may also be a function call
# with its own native argument block. Keep both calls as complete operands.
assert {id {str-size {id "Hello"} + str-size {id "world"}} == 10}
assert {id {str-size {id "Hello"} + {str-size {id "world"}}} == 10}
assert {id {str-size {id "Hi"} + str-size {id " there"} + 1} == 9}

# A right-hand call with inline arguments remains one infix operand even
# when its native directive has an odd number of arguments.
assert {arr-concat {arr 1 2 3; arr 4 5 6; arr 7 8 9} == arr 1 2 3 4 5 6 7 8 9}
assert {str {id "abc"} == str "a" "b" "c"}
assert {id {str-size {id "Hello"} + str-size "world"} == 10}
