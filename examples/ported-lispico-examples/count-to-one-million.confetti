var "counter" 0
label "loop"

if {
  id { counter > 0 }
  && { mod counter 100_000 == id 0 }
} then {
  println { str "Counted to " { type s counter } }
}

if {
  counter < 1_000_000
} then do {
  set "counter" { counter + 1 }
  goto loop
}

assert {
  counter == 1_000_000
  id "Must count to one million"
}
