# An explicit `id` can also introduce the right operand of an infix call.
assert {id {2 + 3} == 5}
assert {id {2 + 3} == id 5}
assert {1 == id 1}
assert {id {1 + id 2} == 3}

# A function call with a native argument block needs no extra `id` wrapper.
assert {type-of {3 - 2} == u32}
assert {id {type-of {3 - 2}} == u32}
assert {div {id 7.5; id 2.0} == 3.0}

# A regular directive may contain a function call followed by an operator.
assert {div 7.5 2.0 == 3.0}
assert {str-size "hello" == 5}

# A function call on the right also consumes its inline arguments up to the
# next operator. Braces remain an equivalent, explicit way to group the call.
var "signed" {arr {type i32 0}}
assert {arr-get "signed" 0 == type i32 0}
assert {arr-get "signed" 0 == {type i32 0}}
assert {0 == type u32 0}
assert {1 == type u32 {id 1}}
assert {"++" == str "+" "+"}

# Chainable operators use the next occurrence as the operand boundary.
assert {id {1 + type u32 2 + 3} == 6}

# Prefix operator calls after a block are still separate expressions.
do {id 5}
+ {id 1; id 2}
assert {id {last-val} == 3}
do {id 5}
== {id 1; id 1}
assert {id {last-val} == 1}
